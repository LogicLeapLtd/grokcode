# ---------------------------------------------------------------------------
# Codessa .gitignore — Swift / Xcode macOS app
# ---------------------------------------------------------------------------
# Note: files already tracked by git are NOT affected by these rules. This only
# stops the build/derived/user-state noise that keeps reappearing in `git status`.

# Build output
build/
DerivedData/
.build/
# Per-agent private derived-data paths, so concurrent agents don't corrupt the
# shared build/ and don't commit build noise (see "Multi-agent & build discipline").
.build-agent*/
.build-final*/
dist/

# Xcode user-specific state
*.xcuserstate
xcuserdata/
*.xcuserdatad/

# Xcode / Swift derived & intermediate
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
.swiftpm/
Package.resolved

# CocoaPods (only if ever used)
Pods/

# Carthage (only if ever used)
Carthage/Build/

# Distribution / packaging artifacts
*.dmg
*.pkg
*.app.zip

# macOS finder / system cruft
.DS_Store
.AppleDouble
.LSOverride
Icon

# Editor / tooling
*.swp
*.swo
*~
.vscode/
.idea/

# Logs & temp
*.log
*.tmp
